; springer-05.mic - Springer (Knight's Tour) fuer Busch Microtronic 2090
; 8x8-LED-Matrix + 4x4-Keypad. Der Springer muss jedes Feld genau einmal betreten.
; Startfeld zufaellig (RND). Besuchte Felder leuchten, das aktuelle Feld blinkt (ca. 0,8-0,9 s an/aus).
; Tasten (Richtung wie auf dem Keypad angeordnet, 0-3 unten, C-F oben):
;   D: 1 links 2 hoch    E: 1 rechts 2 hoch
;   8: 2 links 1 hoch    B: 2 rechts 1 hoch
;   4: 2 links 1 runter  7: 2 rechts 1 runter
;   1: 1 links 2 runter  2: 1 rechts 2 runter
;   0 (halten): Punkte = besuchte Felder dezimal in der Anzeige; loslassen -> weiterspielen
; Ungueltige Zuege (Rand, schon besucht) werden ignoriert. Taste halten, bis der Springer springt.
; Nach jedem Zug prueft das Programm, ob es noch einen Zug gibt. Wenn nicht: Spielende,
; Anzeige = Punkte (64 = gewonnen, alle Felder besucht), Programm bleibt in einer Endlosschleife.
; Waehrend des Spiels ist die Anzeige aus: die Matrix nimmt ein Bild nur bei 9,3 ms je Befehl an.
; Emulator: Matrix vor RUN mit m aktivieren (Programm erwartet die aktive Matrix wie nach dem Einschalten).
; Das Programm loescht R und M selbst (CLEAR/EXRL/EXRM/CLEAR). 255 Schritte (00-FE).

; Register R8-RF (Variablen):
;   8 X (Spalte 0-7, 0 = links)   9 Y (Zeile 0-7, 0 = unten)
;   A BLINK (1 = aktuelles Feld gerade dunkel)   B GEHALTEN (1 = Taste war schon gedrueckt;
;     8-F = Pruefung der Zugmoeglichkeiten, Richtung B-8; F = nach dem Bild pruefen)
;   C ZAEHLER Einer   D ZAEHLER Zehner (besuchte Felder dezimal, 64 = gewonnen; DISP 2,C zeigt ihn)
;   E P (Registernummer des Feldes 0-F; Hilfsregister)   F DELTA / Ergebnis von Zugriff
; R0-R7 Hilfsregister ausserhalb der Fenster:
;   0 DIN / Kopie von P   1 P des aktuellen Feldes   2 Maske K   3,4 alte X,Y   5 dx   6 dy
;   7 H = welche Brett-Haelfte gerade in M0-M7 liegt (0 = unten Zeile 1-4, 8 = oben Zeile 5-8)
; Brett in M0-MF im Matrixformat: Zeile y = M(2y) links (Spalte 1-4), M(2y+1) rechts
; Pruefung: gibt es vom aktuellen Feld noch einen Zug? 8 Richtungen ueber den Zug-Code,
; Start mit der Richtung des letzten Zuges (R5,R6), dreimal um 90 Grad drehen,
; dann x/y tauschen und nochmal dreimal drehen (die Gegenrichtung ist immer besucht)
; Punkte: Taste 0 gehalten -> Zaehler anzeigen, bis sie losgelassen wird
; Pos: E = R1 = 2Y + (X >= 4), R2 = Maske 1 << (X mod 4)
; Zugriff: Brettregister M[E] = M[E] + F, danach F = neuer Wert; benutzt R0, aendert E
; Die gebrauchte Haelfte wird nur getauscht, wenn sie nicht schon in M0-M7 liegt (H in R7).

F08   ; 00  Beginn:   CLEAR        R und M loeschen (Brett leer)
F0D   ; 01            EXRL
F0E   ; 02            EXRM
F08   ; 03            CLEAR
F02   ; 04            DISOUT       Display aus: 9,3 ms je Befehl (Matrix-Takt)
1F0   ; 05            MOVI F,0     Matrix ausschalten (nach dem Einschalten aktiv)
FE0   ; 06            DOT 0
100   ; 07            MOVI 0,0
FE0   ; 08            DOT 0
F05   ; 09            RND          Startfeld zufaellig
0D8   ; 0A            MOV D,8
378   ; 0B            ANDI 7,8     X = 0-7
0E9   ; 0C            MOV E,9
379   ; 0D            ANDI 7,9     Y = 0-7
10D   ; 0E            MOVI 0,D     Zaehler = 1 (Startfeld)
11C   ; 0F            MOVI 1,C
BB8   ; 10            CALL Pos
02F   ; 11            MOV 2,F      Startfeld setzen
BC7   ; 12            CALL Zugriff
11E   ; 13  Scan:     MOVI 1,E     Keypad-Zeile 1 (Tasten 1, 2)
FEE   ; 14            DOT E
FD0   ; 15            DIN 0
F90   ; 16            SHR 0        Taste 0 (Bit 1) -> Carry
DB0   ; 17            BRC Punkte
330   ; 18            ANDI 3,0     Tasten 1, 2 (nach SHR Wert 1, 2)
E1D   ; 19            BRZ S2
FA0   ; 1A            SHL 0        zurueck auf Wert 2, 4
1E6   ; 1B            MOVI E,6     dy = -2
C31   ; 1C            GOTO SpA
12E   ; 1D  S2:       MOVI 2,E     Zeile 2 (Tasten 4, 7)
FEE   ; 1E            DOT E
FD0   ; 1F            DIN 0
390   ; 20            ANDI 9,0
E24   ; 21            BRZ S3
1F6   ; 22            MOVI F,6     dy = -1
C36   ; 23            GOTO SpB
14E   ; 24  S3:       MOVI 4,E     Zeile 3 (Tasten 8, B)
FEE   ; 25            DOT E
FD0   ; 26            DIN 0
390   ; 27            ANDI 9,0
E2B   ; 28            BRZ S4
116   ; 29            MOVI 1,6     dy = +1
C36   ; 2A            GOTO SpB
18E   ; 2B  S4:       MOVI 8,E     Zeile 4 (Tasten D, E)
FEE   ; 2C            DOT E
FD0   ; 2D            DIN 0
360   ; 2E            ANDI 6,0
E63   ; 2F            BRZ Keine
126   ; 30            MOVI 2,6     dy = +2, weiter in SpA
1F5   ; 31  SpA:      MOVI F,5     Spalte 2 (Taste 1, D): dx = -1
920   ; 32            CMPI 2,0
E3A   ; 33            BRZ Taste
115   ; 34            MOVI 1,5     Spalte 3 (Taste 2, E): dx = +1
C3A   ; 35            GOTO Taste
1E5   ; 36  SpB:      MOVI E,5     Spalte 1 (Taste 4, 8): dx = -2
910   ; 37            CMPI 1,0
E3A   ; 38            BRZ Taste
125   ; 39            MOVI 2,5     Spalte 4 (Taste 7, B): dx = +2
90B   ; 3A  Taste:    CMPI 0,B     Carry = Taste wird noch gehalten
11B   ; 3B            MOVI 1,B     MOVI laesst Carry stehen
D64   ; 3C            BRC Blink    gehalten: wie keine Taste
90A   ; 3D            CMPI 0,A     aktuelles Feld gerade dunkel?
E43   ; 3E            BRZ Zug
01E   ; 3F            MOV 1,E      ja: wieder einschalten
02F   ; 40            MOV 2,F
BC7   ; 41            CALL Zugriff
10A   ; 42            MOVI 0,A
083   ; 43  Zug:      MOV 8,3      alte Lage merken
094   ; 44            MOV 9,4
458   ; 45            ADD 5,8
469   ; 46            ADD 6,9
978   ; 47            CMPI 7,8     ausserhalb (Ergebnis 8-F)?
D50   ; 48            BRC Zurueck
979   ; 49            CMPI 7,9
D50   ; 4A            BRC Zurueck
BB8   ; 4B            CALL Pos
10F   ; 4C            MOVI 0,F     nur lesen
BC7   ; 4D            CALL Zugriff
22F   ; 4E            AND 2,F      Feld schon besucht?
E56   ; 4F            BRZ Frei
038   ; 50  Zurueck:  MOV 3,8      ungueltiger Zug: alte Lage
049   ; 51            MOV 4,9
97B   ; 52            CMPI 7,B     Pruefung: naechste Richtung
D9B   ; 53            BRC PrNext
BB8   ; 54            CALL Pos     P und Maske wieder fuer das aktuelle Feld
C64   ; 55            GOTO Blink
97B   ; 56  Frei:     CMPI 7,B     Pruefung: freies Feld gefunden
DA9   ; 57            BRC PrFrei
1FB   ; 58            MOVI F,B     nach dem Bild pruefen, ob es weitergeht
01E   ; 59            MOV 1,E      neues Feld setzen (Pos lief schon)
02F   ; 5A            MOV 2,F
BC7   ; 5B            CALL Zugriff
51C   ; 5C            ADDI 1,C     Zaehler + 1 (dezimal)
99C   ; 5D            CMPI 9,C
D60   ; 5E            BRC Zehner
C6E   ; 5F            GOTO Anzeige
10C   ; 60  Zehner:   MOVI 0,C
51D   ; 61            ADDI 1,D
C6E   ; 62            GOTO Anzeige neues Feld zuerst hell zeigen
10B   ; 63  Keine:    MOVI 0,B     keine Taste
01E   ; 64  Blink:    MOV 1,E      aktuelles Feld umschalten
02F   ; 65            MOV 2,F      F = +K (einschalten)
90A   ; 66            CMPI 0,A
E6A   ; 67            BRZ BlAus
10A   ; 68            MOVI 0,A
C6D   ; 69            GOTO BlTun
10F   ; 6A  BlAus:    MOVI 0,F     F = -K (ausschalten)
62F   ; 6B            SUB 2,F
11A   ; 6C            MOVI 1,A
BC7   ; 6D  BlTun:    CALL Zugriff
907   ; 6E  Anzeige:  CMPI 0,7     untere Haelfte muss in M0-M7 liegen
E76   ; 6F            BRZ AnzEin
F0D   ; 70            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; 71            EXRM
F0F   ; 72            EXRA
F0D   ; 73            EXRL
F0E   ; 74            EXRM
107   ; 75            MOVI 0,7
1F0   ; 76  AnzEin:   MOVI F,0     Matrix einschalten
FE0   ; 77            DOT 0
100   ; 78            MOVI 0,0
FE0   ; 79            DOT 0
F0D   ; 7A            EXRL         R0-R7 = Brett unten
FDE   ; 7B  Bereit:   DIN E        auf Bereit-Signal warten
31E   ; 7C            ANDI 1,E
E7B   ; 7D            BRZ Bereit
FEE   ; 7E            DOT E        Startnibble 1
F0E   ; 7F            EXRM         R8-RF = Brett oben
FE0   ; 80            DOT 0
FE1   ; 81            DOT 1
FE2   ; 82            DOT 2
FE3   ; 83            DOT 3
FE4   ; 84            DOT 4
FE5   ; 85            DOT 5
FE6   ; 86            DOT 6
FE7   ; 87            DOT 7
FE8   ; 88            DOT 8
FE9   ; 89            DOT 9
FEA   ; 8A            DOT A
FEB   ; 8B            DOT B
FEC   ; 8C            DOT C
FED   ; 8D            DOT D
FEE   ; 8E            DOT E
FEF   ; 8F            DOT F
F0E   ; 90            EXRM
10E   ; 91            MOVI 0,E     Endnibble 0
FEE   ; 92            DOT E
F0D   ; 93            EXRL
1F0   ; 94            MOVI F,0     Matrix ausschalten (Keypad frei)
FE0   ; 95            DOT 0
100   ; 96            MOVI 0,0
FE0   ; 97            DOT 0
97B   ; 98            CMPI 7,B     gerade gezogen? -> Pruefung (siehe unten)
D43   ; 99            BRC Zug
C13   ; 9A            GOTO Scan
71B   ; 9B  PrNext:   SUBI 1,B
97B   ; 9C            CMPI 7,B
EAE   ; 9D            BRZ Fertig   alle 8 Richtungen gesperrt
9BB   ; 9E            CMPI B,B
EA5   ; 9F            BRZ PrTausch
060   ; A0            MOV 6,0      drehen: (dx,dy) -> (-dy,dx)
056   ; A1            MOV 5,6
105   ; A2            MOVI 0,5
605   ; A3            SUB 0,5
C43   ; A4            GOTO Zug
050   ; A5  PrTausch: MOV 5,0      dx und dy tauschen
065   ; A6            MOV 6,5
006   ; A7            MOV 0,6
C43   ; A8            GOTO Zug
038   ; A9  PrFrei:   MOV 3,8      es geht weiter: aktuelle Lage zurueck
049   ; AA            MOV 4,9
BB8   ; AB            CALL Pos
11B   ; AC            MOVI 1,B     Taste gilt weiter als gehalten
C13   ; AD            GOTO Scan
F2C   ; AE  Fertig:   DISP 2,C     kein Zug mehr: Punkte anzeigen (64 = gewonnen)
CAF   ; AF  Ende:     GOTO Ende
F2C   ; B0  Punkte:   DISP 2,C     Anzeige an (Matrix behaelt ihr Bild)
11E   ; B1  PkWarte:  MOVI 1,E     Keypad-Zeile 1
FEE   ; B2            DOT E
FD0   ; B3            DIN 0
F90   ; B4            SHR 0        Taste 0 noch gedrueckt?
DB1   ; B5            BRC PkWarte
F02   ; B6            DISOUT       Anzeige aus: wieder Matrix-Takt
C13   ; B7            GOTO Scan
09E   ; B8  Pos:      MOV 9,E
4EE   ; B9            ADD E,E
938   ; BA            CMPI 3,8
FBE   ; BB            ADC E
0E1   ; BC            MOV E,1
082   ; BD            MOV 8,2      X mod 4 = 0,1,2,3
332   ; BE            ANDI 3,2
512   ; BF            ADDI 1,2     1,2,3,4
922   ; C0            CMPI 2,2
DC3   ; C1            BRC PsHoch
F07   ; C2            RET          1, 2 stimmen schon
722   ; C3  PsHoch:   SUBI 2,2     3,4 -> 1,2 -> 4,8
422   ; C4            ADD 2,2
422   ; C5            ADD 2,2
F07   ; C6            RET
0E0   ; C7  Zugriff:  MOV E,0
380   ; C8            ANDI 8,0     gebrauchte Haelfte 0 / 8
807   ; C9            CMP 0,7
ED1   ; CA            BRZ Auf
F0D   ; CB            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; CC            EXRM
F0F   ; CD            EXRA
F0D   ; CE            EXRL
F0E   ; CF            EXRM
007   ; D0            MOV 0,7      H merken
37E   ; D1  Auf:      ANDI 7,E
F0D   ; D2            EXRL         Fenster: R0-R7 = Brett
93E   ; D3            CMPI 3,E
DEA   ; D4            BRC AHoch
91E   ; D5            CMPI 1,E
DE0   ; D6            BRC A23
EDC   ; D7            BRZ L1
4F0   ; D8  L0:       ADD F,0
00F   ; D9            MOV 0,F
F0D   ; DA            EXRL         Fenster zu
F07   ; DB            RET
4F1   ; DC  L1:       ADD F,1
01F   ; DD            MOV 1,F
F0D   ; DE            EXRL         Fenster zu
F07   ; DF            RET
92E   ; E0  A23:      CMPI 2,E
EE6   ; E1            BRZ L2
4F3   ; E2  L3:       ADD F,3
03F   ; E3            MOV 3,F
F0D   ; E4            EXRL         Fenster zu
F07   ; E5            RET
4F2   ; E6  L2:       ADD F,2
02F   ; E7            MOV 2,F
F0D   ; E8            EXRL         Fenster zu
F07   ; E9            RET
95E   ; EA  AHoch:    CMPI 5,E
DF5   ; EB            BRC A67
EF1   ; EC            BRZ L5
4F4   ; ED  L4:       ADD F,4
04F   ; EE            MOV 4,F
F0D   ; EF            EXRL         Fenster zu
F07   ; F0            RET
4F5   ; F1  L5:       ADD F,5
05F   ; F2            MOV 5,F
F0D   ; F3            EXRL         Fenster zu
F07   ; F4            RET
96E   ; F5  A67:      CMPI 6,E
EFB   ; F6            BRZ L6
4F7   ; F7  L7:       ADD F,7
07F   ; F8            MOV 7,F
F0D   ; F9            EXRL         Fenster zu
F07   ; FA            RET
4F6   ; FB  L6:       ADD F,6
06F   ; FC            MOV 6,F
F0D   ; FD  Zu:       EXRL         Fenster zu
F07   ; FE            RET
