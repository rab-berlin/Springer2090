; springer-06.mic - Springer (Knight's Tour) fuer Busch Microtronic 2090
; 8x8-LED-Matrix (ESP2090 Studio) + 4x4-Keypad. Der Springer muss jedes Feld genau einmal betreten.
; Startfeld zufaellig (RND). Besuchte Felder leuchten, das aktuelle Feld blinkt (ca. 0,8-0,9 s an/aus).
; Tasten (Richtung wie auf dem Keypad angeordnet, 0-3 unten, C-F oben):
;   D: 1 links 2 hoch    E: 1 rechts 2 hoch
;   8: 2 links 1 hoch    B: 2 rechts 1 hoch
;   4: 2 links 1 runter  7: 2 rechts 1 runter
;   1: 1 links 2 runter  2: 1 rechts 2 runter
;   0 (halten): Punkte = besuchte Felder dezimal in der Anzeige; loslassen -> weiterspielen
; Ungueltige Zuege (Rand, schon besucht) werden ignoriert. Taste halten, bis der Springer springt.
; Nach jedem Zug prueft das Programm, ob es noch einen Zug gibt. Wenn nicht: Spielende,
; Anzeige = Punkte (64 = gewonnen, alle Felder besucht), Programm bleibt in einer Endlosschleife.
; Waehrend des Spiels ist die Anzeige aus: die Matrix nimmt ein Bild nur bei 9,3 ms je Befehl an.
; Matrix vor RUN einschalten (Weboberflaeche: LED on, Emulator2090: m). Zwischen den Bildern schlaeft sie
;   (ACK 15, kein REQ, Ausgaenge werden ignoriert), damit das Keypad Eingang 1 und die Ausgaenge nutzen kann;
;   vor dem Bild weckt F, dann folgt sofort ACK 1 mit den 16 Registern.
; Das Programm loescht R und M selbst (CLEAR/EXRL/EXRM/CLEAR). 252 Schritte (00-FB), frei: 4.
; Version 06: ESP2090 Studio (Schlaf/Wecken statt Umschaltsignal, Schlaf-Routine am Ende), 3 Schritte weniger.

; Register R8-RF (Variablen):
;   8 X (Spalte 0-7, 0 = links)   9 Y (Zeile 0-7, 0 = unten)
;   A BLINK (1 = aktuelles Feld gerade dunkel)   B GEHALTEN (1 = Taste war schon gedrueckt;
;     8-F = Pruefung der Zugmoeglichkeiten, Richtung B-8; F = nach dem Bild pruefen)
;   C ZAEHLER Einer   D ZAEHLER Zehner (besuchte Felder dezimal, 64 = gewonnen; DISP 2,C zeigt ihn)
;   E P (Registernummer des Feldes 0-F; Hilfsregister)   F DELTA / Ergebnis von Zugriff
; R0-R7 Hilfsregister ausserhalb der Fenster:
;   0 DIN / Kopie von P   1 P des aktuellen Feldes   2 Maske K   3,4 alte X,Y   5 dx   6 dy
;   7 H = welche Brett-Haelfte gerade in M0-M7 liegt (0 = unten Zeile 1-4, 8 = oben Zeile 5-8)
; Brett in M0-MF im Matrixformat: Zeile y = M(2y) links (Spalte 1-4), M(2y+1) rechts
; Pruefung: gibt es vom aktuellen Feld noch einen Zug? 8 Richtungen ueber den Zug-Code,
; Start mit der Richtung des letzten Zuges (R5,R6), dreimal um 90 Grad drehen,
; dann x/y tauschen und nochmal dreimal drehen (die Gegenrichtung ist immer besucht)
; Punkte: Taste 0 gehalten -> Zaehler anzeigen, bis sie losgelassen wird
; Pos: E = R1 = 2Y + (X >= 4), R2 = Maske 1 << (X mod 4)
; Zugriff: Brettregister M[E] = M[E] + F, danach F = neuer Wert; benutzt R0, aendert E
; Die gebrauchte Haelfte wird nur getauscht, wenn sie nicht schon in M0-M7 liegt (H in R7).

F08   ; 00  Beginn:   CLEAR        R und M loeschen (Brett leer)
F0D   ; 01            EXRL
F0E   ; 02            EXRM
F08   ; 03            CLEAR
F02   ; 04            DISOUT       Display aus: 9,3 ms je Befehl (Matrix-Takt)
BF4   ; 05            CALL Schlaf  Matrix schlafen: Eingang 1 und Ausgaenge frei fuers Keypad
F05   ; 06            RND          Startfeld zufaellig
0D8   ; 07            MOV D,8
378   ; 08            ANDI 7,8     X = 0-7
0E9   ; 09            MOV E,9
379   ; 0A            ANDI 7,9     Y = 0-7
10D   ; 0B            MOVI 0,D     Zaehler = 1 (Startfeld)
11C   ; 0C            MOVI 1,C
BAD   ; 0D            CALL Pos
02F   ; 0E            MOV 2,F      Startfeld setzen
BBC   ; 0F            CALL Zugriff
11E   ; 10  Scan:     MOVI 1,E     Keypad-Zeile 1 (Tasten 1, 2)
FEE   ; 11            DOT E
FD0   ; 12            DIN 0
F90   ; 13            SHR 0        Taste 0 (Bit 1) -> Carry
DA5   ; 14            BRC Punkte
330   ; 15            ANDI 3,0     Tasten 1, 2 (nach SHR Wert 1, 2)
E1A   ; 16            BRZ S2
FA0   ; 17            SHL 0        zurueck auf Wert 2, 4
1E6   ; 18            MOVI E,6     dy = -2
C2E   ; 19            GOTO SpA
12E   ; 1A  S2:       MOVI 2,E     Zeile 2 (Tasten 4, 7)
FEE   ; 1B            DOT E
FD0   ; 1C            DIN 0
390   ; 1D            ANDI 9,0
E21   ; 1E            BRZ S3
1F6   ; 1F            MOVI F,6     dy = -1
C33   ; 20            GOTO SpB
14E   ; 21  S3:       MOVI 4,E     Zeile 3 (Tasten 8, B)
FEE   ; 22            DOT E
FD0   ; 23            DIN 0
390   ; 24            ANDI 9,0
E28   ; 25            BRZ S4
116   ; 26            MOVI 1,6     dy = +1
C33   ; 27            GOTO SpB
18E   ; 28  S4:       MOVI 8,E     Zeile 4 (Tasten D, E)
FEE   ; 29            DOT E
FD0   ; 2A            DIN 0
360   ; 2B            ANDI 6,0
E60   ; 2C            BRZ Keine
126   ; 2D            MOVI 2,6     dy = +2, weiter in SpA
1F5   ; 2E  SpA:      MOVI F,5     Spalte 2 (Taste 1, D): dx = -1
920   ; 2F            CMPI 2,0
E37   ; 30            BRZ Taste
115   ; 31            MOVI 1,5     Spalte 3 (Taste 2, E): dx = +1
C37   ; 32            GOTO Taste
1E5   ; 33  SpB:      MOVI E,5     Spalte 1 (Taste 4, 8): dx = -2
910   ; 34            CMPI 1,0
E37   ; 35            BRZ Taste
125   ; 36            MOVI 2,5     Spalte 4 (Taste 7, B): dx = +2
90B   ; 37  Taste:    CMPI 0,B     Carry = Taste wird noch gehalten
11B   ; 38            MOVI 1,B     MOVI laesst Carry stehen
D61   ; 39            BRC Blink    gehalten: wie keine Taste
90A   ; 3A            CMPI 0,A     aktuelles Feld gerade dunkel?
E40   ; 3B            BRZ Zug
01E   ; 3C            MOV 1,E      ja: wieder einschalten
02F   ; 3D            MOV 2,F
BBC   ; 3E            CALL Zugriff
10A   ; 3F            MOVI 0,A
083   ; 40  Zug:      MOV 8,3      alte Lage merken
094   ; 41            MOV 9,4
458   ; 42            ADD 5,8
469   ; 43            ADD 6,9
978   ; 44            CMPI 7,8     ausserhalb (Ergebnis 8-F)?
D4D   ; 45            BRC Zurueck
979   ; 46            CMPI 7,9
D4D   ; 47            BRC Zurueck
BAD   ; 48            CALL Pos
10F   ; 49            MOVI 0,F     nur lesen
BBC   ; 4A            CALL Zugriff
22F   ; 4B            AND 2,F      Feld schon besucht?
E53   ; 4C            BRZ Frei
038   ; 4D  Zurueck:  MOV 3,8      ungueltiger Zug: alte Lage
049   ; 4E            MOV 4,9
97B   ; 4F            CMPI 7,B     Pruefung: naechste Richtung
D90   ; 50            BRC PrNext
BAD   ; 51            CALL Pos     P und Maske wieder fuer das aktuelle Feld
C61   ; 52            GOTO Blink
97B   ; 53  Frei:     CMPI 7,B     Pruefung: freies Feld gefunden
D9E   ; 54            BRC PrFrei
1FB   ; 55            MOVI F,B     nach dem Bild pruefen, ob es weitergeht
01E   ; 56            MOV 1,E      neues Feld setzen (Pos lief schon)
02F   ; 57            MOV 2,F
BBC   ; 58            CALL Zugriff
51C   ; 59            ADDI 1,C     Zaehler + 1 (dezimal)
99C   ; 5A            CMPI 9,C
D5D   ; 5B            BRC Zehner
C6B   ; 5C            GOTO Anzeige
10C   ; 5D  Zehner:   MOVI 0,C
51D   ; 5E            ADDI 1,D
C6B   ; 5F            GOTO Anzeige neues Feld zuerst hell zeigen
10B   ; 60  Keine:    MOVI 0,B     keine Taste
01E   ; 61  Blink:    MOV 1,E      aktuelles Feld umschalten
02F   ; 62            MOV 2,F      F = +K (einschalten)
90A   ; 63            CMPI 0,A
E67   ; 64            BRZ BlAus
10A   ; 65            MOVI 0,A
C6A   ; 66            GOTO BlTun
10F   ; 67  BlAus:    MOVI 0,F     F = -K (ausschalten)
62F   ; 68            SUB 2,F
11A   ; 69            MOVI 1,A
BBC   ; 6A  BlTun:    CALL Zugriff
907   ; 6B  Anzeige:  CMPI 0,7     untere Haelfte muss in M0-M7 liegen
E73   ; 6C            BRZ AnzEin
F0D   ; 6D            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; 6E            EXRM
F0F   ; 6F            EXRA
F0D   ; 70            EXRL
F0E   ; 71            EXRM
107   ; 72            MOVI 0,7
BF7   ; 73  AnzEin:   CALL Tog     Matrix wecken (F, dann 0): der ESP setzt sofort REQ
F0D   ; 74            EXRL         R0-R7 = Brett unten
11E   ; 75            MOVI 1,E     ACK 1 = Blockmodus (REQ steht nach dem Wecken)
FEE   ; 76            DOT E        ACK 1
F0E   ; 77            EXRM         genau ein Befehl zwischen ACK und erstem Wert: R8-RF = Brett oben
FE0   ; 78            DOT 0
FE1   ; 79            DOT 1
FE2   ; 7A            DOT 2
FE3   ; 7B            DOT 3
FE4   ; 7C            DOT 4
FE5   ; 7D            DOT 5
FE6   ; 7E            DOT 6
FE7   ; 7F            DOT 7
FE8   ; 80            DOT 8
FE9   ; 81            DOT 9
FEA   ; 82            DOT A
FEB   ; 83            DOT B
FEC   ; 84            DOT C
FED   ; 85            DOT D
FEE   ; 86            DOT E
FEF   ; 87            DOT F
F0E   ; 88            EXRM
10E   ; 89            MOVI 0,E     Ausgaenge 0: Uebertragung fertig
FEE   ; 8A            DOT E
F0D   ; 8B            EXRL
BF4   ; 8C            CALL Schlaf  Matrix schlafen (Keypad frei)
97B   ; 8D            CMPI 7,B     gerade gezogen? -> Pruefung (siehe unten)
D40   ; 8E            BRC Zug
C10   ; 8F            GOTO Scan
71B   ; 90  PrNext:   SUBI 1,B
97B   ; 91            CMPI 7,B
EA3   ; 92            BRZ Fertig   alle 8 Richtungen gesperrt
9BB   ; 93            CMPI B,B
E9A   ; 94            BRZ PrTausch
060   ; 95            MOV 6,0      drehen: (dx,dy) -> (-dy,dx)
056   ; 96            MOV 5,6
105   ; 97            MOVI 0,5
605   ; 98            SUB 0,5
C40   ; 99            GOTO Zug
050   ; 9A  PrTausch: MOV 5,0      dx und dy tauschen
065   ; 9B            MOV 6,5
006   ; 9C            MOV 0,6
C40   ; 9D            GOTO Zug
038   ; 9E  PrFrei:   MOV 3,8      es geht weiter: aktuelle Lage zurueck
049   ; 9F            MOV 4,9
BAD   ; A0            CALL Pos
11B   ; A1            MOVI 1,B     Taste gilt weiter als gehalten
C10   ; A2            GOTO Scan
F2C   ; A3  Fertig:   DISP 2,C     kein Zug mehr: Punkte anzeigen (64 = gewonnen)
CA4   ; A4  Ende:     GOTO Ende
F2C   ; A5  Punkte:   DISP 2,C     Anzeige an (Matrix behaelt ihr Bild)
11E   ; A6  PkWarte:  MOVI 1,E     Keypad-Zeile 1
FEE   ; A7            DOT E
FD0   ; A8            DIN 0
F90   ; A9            SHR 0        Taste 0 noch gedrueckt?
DA6   ; AA            BRC PkWarte
F02   ; AB            DISOUT       Anzeige aus: wieder Matrix-Takt
C10   ; AC            GOTO Scan
09E   ; AD  Pos:      MOV 9,E
4EE   ; AE            ADD E,E
938   ; AF            CMPI 3,8
FBE   ; B0            ADC E
0E1   ; B1            MOV E,1
082   ; B2            MOV 8,2      X mod 4 = 0,1,2,3
332   ; B3            ANDI 3,2
512   ; B4            ADDI 1,2     1,2,3,4
922   ; B5            CMPI 2,2
DB8   ; B6            BRC PsHoch
F07   ; B7            RET          1, 2 stimmen schon
722   ; B8  PsHoch:   SUBI 2,2     3,4 -> 1,2 -> 4,8
422   ; B9            ADD 2,2
422   ; BA            ADD 2,2
F07   ; BB            RET
0E0   ; BC  Zugriff:  MOV E,0
380   ; BD            ANDI 8,0     gebrauchte Haelfte 0 / 8
807   ; BE            CMP 0,7
EC6   ; BF            BRZ Auf
F0D   ; C0            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; C1            EXRM
F0F   ; C2            EXRA
F0D   ; C3            EXRL
F0E   ; C4            EXRM
007   ; C5            MOV 0,7      H merken
37E   ; C6  Auf:      ANDI 7,E
F0D   ; C7            EXRL         Fenster: R0-R7 = Brett
93E   ; C8            CMPI 3,E
DDF   ; C9            BRC AHoch
91E   ; CA            CMPI 1,E
DD5   ; CB            BRC A23
ED1   ; CC            BRZ L1
4F0   ; CD  L0:       ADD F,0
00F   ; CE            MOV 0,F
F0D   ; CF            EXRL         Fenster zu
F07   ; D0            RET
4F1   ; D1  L1:       ADD F,1
01F   ; D2            MOV 1,F
F0D   ; D3            EXRL         Fenster zu
F07   ; D4            RET
92E   ; D5  A23:      CMPI 2,E
EDB   ; D6            BRZ L2
4F3   ; D7  L3:       ADD F,3
03F   ; D8            MOV 3,F
F0D   ; D9            EXRL         Fenster zu
F07   ; DA            RET
4F2   ; DB  L2:       ADD F,2
02F   ; DC            MOV 2,F
F0D   ; DD            EXRL         Fenster zu
F07   ; DE            RET
95E   ; DF  AHoch:    CMPI 5,E
DEA   ; E0            BRC A67
EE6   ; E1            BRZ L5
4F4   ; E2  L4:       ADD F,4
04F   ; E3            MOV 4,F
F0D   ; E4            EXRL         Fenster zu
F07   ; E5            RET
4F5   ; E6  L5:       ADD F,5
05F   ; E7            MOV 5,F
F0D   ; E8            EXRL         Fenster zu
F07   ; E9            RET
96E   ; EA  A67:      CMPI 6,E
EF0   ; EB            BRZ L6
4F7   ; EC  L7:       ADD F,7
07F   ; ED            MOV 7,F
F0D   ; EE            EXRL         Fenster zu
F07   ; EF            RET
4F6   ; F0  L6:       ADD F,6
06F   ; F1            MOV 6,F
F0D   ; F2  Zu:       EXRL         Fenster zu
F07   ; F3            RET
FD0   ; F4  Schlaf:   DIN 0        Matrix schlafen legen: auf REQ (Eingang 1) warten ...
310   ; F5            ANDI 1,0
EF4   ; F6            BRZ Schlaf
1F0   ; F7  Tog:      MOVI F,0     ... ACK 15 (schlafen); Einsprung Tog: F weckt die Matrix
FE0   ; F8            DOT 0
100   ; F9            MOVI 0,0     Ausgaenge 0: nach dem Schlafen kann F wieder wecken,
FE0   ; FA            DOT 0        nach dem Wecken gilt das naechste ACK
F07   ; FB            RET
