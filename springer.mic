; springer-09.mic - Springer (Knight's Tour) fuer Busch Microtronic 2090
; 8x8-LED-Matrix (ESP2090 Studio) + 4x4-Keypad. Der Springer muss jedes Feld genau einmal betreten.
; Startfeld zufaellig (RND). Besuchte Felder leuchten, das aktuelle Feld blinkt (ca. 0,8-0,9 s an/aus).
; Tasten (Richtung wie auf dem Keypad angeordnet, 0-3 unten, C-F oben):
;   D: 1 links 2 hoch    E: 1 rechts 2 hoch
;   8: 2 links 1 hoch    B: 2 rechts 1 hoch
;   4: 2 links 1 runter  7: 2 rechts 1 runter
;   1: 1 links 2 runter  2: 1 rechts 2 runter
;   0 (halten): Punkte = besuchte Felder dezimal in der Anzeige; loslassen -> weiterspielen
; Ungueltige Zuege (Rand, schon besucht) werden ignoriert. Taste halten, bis der Springer springt.
; Nach jedem Zug prueft das Programm, ob es noch einen Zug gibt. Wenn nicht: Spielende,
; Anzeige = Punkte (64 = gewonnen, alle Felder besucht), Programm bleibt in einer Endlosschleife.
; Waehrend des Spiels ist die Anzeige aus: die Matrix nimmt ein Bild nur bei 9,3 ms je Befehl an.
; Matrix vor RUN einschalten (Weboberflaeche: LED on, Emulator2090: m). Zwischen den Bildern schlaeft sie
;   (ACK 15, kein REQ, Ausgaenge werden ignoriert), damit das Keypad Eingang 1 und die Ausgaenge nutzen kann;
;   vor dem Bild weckt F, dann folgt ACK 1 mit den 16 Registern.
; Das Programm loescht R und M selbst (CLEAR/EXRL/EXRM/CLEAR). 246 Schritte (00-F5), frei: 10.
; Version 06: ESP2090 Studio (Schlaf/Wecken statt Umschaltsignal, Schlaf-Routine am Ende), 3 Schritte weniger.
; Version 07: nach dem Wecken auf REQ warten statt ACK 1 blind zu senden (+2 Schritte).
; Version 08: Wecken als Handshake. Das F bleibt stehen, bis der ESP mit REQ antwortet, dann folgt direkt
;   ACK 1 (keine 0 dazwischen). So geht kein Wecken verloren, egal wie spaet der ESP nachsieht.
; Version 09: Der ESP schlaeft nach dem Bild von selbst wieder ein (ACK direkt aus dem gehaltenen F =
;   ein Befehl je Wecken). Das Schlafenlegen mit ACK 15 entfaellt, das Programm wartet nur noch beim
;   Wecken auf REQ. Das erste Bild kommt jetzt vor der ersten Keypad-Abfrage.

; Register R8-RF (Variablen):
;   8 X (Spalte 0-7, 0 = links)   9 Y (Zeile 0-7, 0 = unten)
;   A BLINK (1 = aktuelles Feld gerade dunkel)   B GEHALTEN (1 = Taste war schon gedrueckt;
;     8-F = Pruefung der Zugmoeglichkeiten, Richtung B-8; F = nach dem Bild pruefen)
;   C ZAEHLER Einer   D ZAEHLER Zehner (besuchte Felder dezimal, 64 = gewonnen; DISP 2,C zeigt ihn)
;   E P (Registernummer des Feldes 0-F; Hilfsregister)   F DELTA / Ergebnis von Zugriff
; R0-R7 Hilfsregister ausserhalb der Fenster:
;   0 DIN / Kopie von P   1 P des aktuellen Feldes   2 Maske K   3,4 alte X,Y   5 dx   6 dy
;   7 H = welche Brett-Haelfte gerade in M0-M7 liegt (0 = unten Zeile 1-4, 8 = oben Zeile 5-8)
; Brett in M0-MF im Matrixformat: Zeile y = M(2y) links (Spalte 1-4), M(2y+1) rechts
; Pruefung: gibt es vom aktuellen Feld noch einen Zug? 8 Richtungen ueber den Zug-Code,
; Start mit der Richtung des letzten Zuges (R5,R6), dreimal um 90 Grad drehen,
; dann x/y tauschen und nochmal dreimal drehen (die Gegenrichtung ist immer besucht)
; Punkte: Taste 0 gehalten -> Zaehler anzeigen, bis sie losgelassen wird
; Pos: E = R1 = 2Y + (X >= 4), R2 = Maske 1 << (X mod 4)
; Zugriff: Brettregister M[E] = M[E] + F, danach F = neuer Wert; benutzt R0, aendert E
; Die gebrauchte Haelfte wird nur getauscht, wenn sie nicht schon in M0-M7 liegt (H in R7).

F08   ; 00  Beginn:   CLEAR        R und M loeschen (Brett leer)
F0D   ; 01            EXRL
F0E   ; 02            EXRM
F08   ; 03            CLEAR
F02   ; 04            DISOUT       Display aus: 9,3 ms je Befehl (Matrix-Takt)
F05   ; 05            RND          Startfeld zufaellig
0D8   ; 06            MOV D,8
378   ; 07            ANDI 7,8     X = 0-7
0E9   ; 08            MOV E,9
379   ; 09            ANDI 7,9     Y = 0-7
10D   ; 0A            MOVI 0,D     Zaehler = 1 (Startfeld)
11C   ; 0B            MOVI 1,C
BAF   ; 0C            CALL Pos
02F   ; 0D            MOV 2,F      Startfeld setzen
BBE   ; 0E            CALL Zugriff
C6B   ; 0F            GOTO Anzeige erstes Bild vor der ersten Keypad-Abfrage (danach schlaeft die Matrix)
11E   ; 10  Scan:     MOVI 1,E     Keypad-Zeile 1 (Tasten 1, 2)
FEE   ; 11            DOT E
FD0   ; 12            DIN 0
F90   ; 13            SHR 0        Taste 0 (Bit 1) -> Carry
DA7   ; 14            BRC Punkte
330   ; 15            ANDI 3,0     Tasten 1, 2 (nach SHR Wert 1, 2)
E1A   ; 16            BRZ S2
FA0   ; 17            SHL 0        zurueck auf Wert 2, 4
1E6   ; 18            MOVI E,6     dy = -2
C2E   ; 19            GOTO SpA
12E   ; 1A  S2:       MOVI 2,E     Zeile 2 (Tasten 4, 7)
FEE   ; 1B            DOT E
FD0   ; 1C            DIN 0
390   ; 1D            ANDI 9,0
E21   ; 1E            BRZ S3
1F6   ; 1F            MOVI F,6     dy = -1
C33   ; 20            GOTO SpB
14E   ; 21  S3:       MOVI 4,E     Zeile 3 (Tasten 8, B)
FEE   ; 22            DOT E
FD0   ; 23            DIN 0
390   ; 24            ANDI 9,0
E28   ; 25            BRZ S4
116   ; 26            MOVI 1,6     dy = +1
C33   ; 27            GOTO SpB
18E   ; 28  S4:       MOVI 8,E     Zeile 4 (Tasten D, E)
FEE   ; 29            DOT E
FD0   ; 2A            DIN 0
360   ; 2B            ANDI 6,0
E60   ; 2C            BRZ Keine
126   ; 2D            MOVI 2,6     dy = +2, weiter in SpA
1F5   ; 2E  SpA:      MOVI F,5     Spalte 2 (Taste 1, D): dx = -1
920   ; 2F            CMPI 2,0
E37   ; 30            BRZ Taste
115   ; 31            MOVI 1,5     Spalte 3 (Taste 2, E): dx = +1
C37   ; 32            GOTO Taste
1E5   ; 33  SpB:      MOVI E,5     Spalte 1 (Taste 4, 8): dx = -2
910   ; 34            CMPI 1,0
E37   ; 35            BRZ Taste
125   ; 36            MOVI 2,5     Spalte 4 (Taste 7, B): dx = +2
90B   ; 37  Taste:    CMPI 0,B     Carry = Taste wird noch gehalten
11B   ; 38            MOVI 1,B     MOVI laesst Carry stehen
D61   ; 39            BRC Blink    gehalten: wie keine Taste
90A   ; 3A            CMPI 0,A     aktuelles Feld gerade dunkel?
E40   ; 3B            BRZ Zug
01E   ; 3C            MOV 1,E      ja: wieder einschalten
02F   ; 3D            MOV 2,F
BBE   ; 3E            CALL Zugriff
10A   ; 3F            MOVI 0,A
083   ; 40  Zug:      MOV 8,3      alte Lage merken
094   ; 41            MOV 9,4
458   ; 42            ADD 5,8
469   ; 43            ADD 6,9
978   ; 44            CMPI 7,8     ausserhalb (Ergebnis 8-F)?
D4D   ; 45            BRC Zurueck
979   ; 46            CMPI 7,9
D4D   ; 47            BRC Zurueck
BAF   ; 48            CALL Pos
10F   ; 49            MOVI 0,F     nur lesen
BBE   ; 4A            CALL Zugriff
22F   ; 4B            AND 2,F      Feld schon besucht?
E53   ; 4C            BRZ Frei
038   ; 4D  Zurueck:  MOV 3,8      ungueltiger Zug: alte Lage
049   ; 4E            MOV 4,9
97B   ; 4F            CMPI 7,B     Pruefung: naechste Richtung
D92   ; 50            BRC PrNext
BAF   ; 51            CALL Pos     P und Maske wieder fuer das aktuelle Feld
C61   ; 52            GOTO Blink
97B   ; 53  Frei:     CMPI 7,B     Pruefung: freies Feld gefunden
DA0   ; 54            BRC PrFrei
1FB   ; 55            MOVI F,B     nach dem Bild pruefen, ob es weitergeht
01E   ; 56            MOV 1,E      neues Feld setzen (Pos lief schon)
02F   ; 57            MOV 2,F
BBE   ; 58            CALL Zugriff
51C   ; 59            ADDI 1,C     Zaehler + 1 (dezimal)
99C   ; 5A            CMPI 9,C
D5D   ; 5B            BRC Zehner
C6B   ; 5C            GOTO Anzeige
10C   ; 5D  Zehner:   MOVI 0,C
51D   ; 5E            ADDI 1,D
C6B   ; 5F            GOTO Anzeige neues Feld zuerst hell zeigen
10B   ; 60  Keine:    MOVI 0,B     keine Taste
01E   ; 61  Blink:    MOV 1,E      aktuelles Feld umschalten
02F   ; 62            MOV 2,F      F = +K (einschalten)
90A   ; 63            CMPI 0,A
E67   ; 64            BRZ BlAus
10A   ; 65            MOVI 0,A
C6A   ; 66            GOTO BlTun
10F   ; 67  BlAus:    MOVI 0,F     F = -K (ausschalten)
62F   ; 68            SUB 2,F
11A   ; 69            MOVI 1,A
BBE   ; 6A  BlTun:    CALL Zugriff
907   ; 6B  Anzeige:  CMPI 0,7     untere Haelfte muss in M0-M7 liegen
E73   ; 6C            BRZ AnzEin
F0D   ; 6D            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; 6E            EXRM
F0F   ; 6F            EXRA
F0D   ; 70            EXRL
F0E   ; 71            EXRM
107   ; 72            MOVI 0,7
1FE   ; 73  AnzEin:   MOVI F,E     Matrix wecken: F anlegen und halten ...
FEE   ; 74            DOT E
F0D   ; 75            EXRL         R0-R7 = Brett unten
FDE   ; 76  Bereit:   DIN E        ... bis der ESP mit REQ antwortet (danach = 1 = ACK)
31E   ; 77            ANDI 1,E
E76   ; 78            BRZ Bereit
FEE   ; 79            DOT E        ACK 1 direkt nach dem F
F0E   ; 7A            EXRM         genau ein Befehl zwischen ACK und erstem Wert: R8-RF = Brett oben
FE0   ; 7B            DOT 0
FE1   ; 7C            DOT 1
FE2   ; 7D            DOT 2
FE3   ; 7E            DOT 3
FE4   ; 7F            DOT 4
FE5   ; 80            DOT 5
FE6   ; 81            DOT 6
FE7   ; 82            DOT 7
FE8   ; 83            DOT 8
FE9   ; 84            DOT 9
FEA   ; 85            DOT A
FEB   ; 86            DOT B
FEC   ; 87            DOT C
FED   ; 88            DOT D
FEE   ; 89            DOT E
FEF   ; 8A            DOT F
F0E   ; 8B            EXRM
10E   ; 8C            MOVI 0,E     Ausgaenge 0: Uebertragung fertig
FEE   ; 8D            DOT E
F0D   ; 8E            EXRL
97B   ; 8F            CMPI 7,B     gerade gezogen? -> Pruefung (siehe unten)
D40   ; 90            BRC Zug
C10   ; 91            GOTO Scan
71B   ; 92  PrNext:   SUBI 1,B
97B   ; 93            CMPI 7,B
EA5   ; 94            BRZ Fertig   alle 8 Richtungen gesperrt
9BB   ; 95            CMPI B,B
E9C   ; 96            BRZ PrTausch
060   ; 97            MOV 6,0      drehen: (dx,dy) -> (-dy,dx)
056   ; 98            MOV 5,6
105   ; 99            MOVI 0,5
605   ; 9A            SUB 0,5
C40   ; 9B            GOTO Zug
050   ; 9C  PrTausch: MOV 5,0      dx und dy tauschen
065   ; 9D            MOV 6,5
006   ; 9E            MOV 0,6
C40   ; 9F            GOTO Zug
038   ; A0  PrFrei:   MOV 3,8      es geht weiter: aktuelle Lage zurueck
049   ; A1            MOV 4,9
BAF   ; A2            CALL Pos
11B   ; A3            MOVI 1,B     Taste gilt weiter als gehalten
C10   ; A4            GOTO Scan
F2C   ; A5  Fertig:   DISP 2,C     kein Zug mehr: Punkte anzeigen (64 = gewonnen)
CA6   ; A6  Ende:     GOTO Ende
F2C   ; A7  Punkte:   DISP 2,C     Anzeige an (Matrix behaelt ihr Bild)
11E   ; A8  PkWarte:  MOVI 1,E     Keypad-Zeile 1
FEE   ; A9            DOT E
FD0   ; AA            DIN 0
F90   ; AB            SHR 0        Taste 0 noch gedrueckt?
DA8   ; AC            BRC PkWarte
F02   ; AD            DISOUT       Anzeige aus: wieder Matrix-Takt
C10   ; AE            GOTO Scan
09E   ; AF  Pos:      MOV 9,E
4EE   ; B0            ADD E,E
938   ; B1            CMPI 3,8
FBE   ; B2            ADC E
0E1   ; B3            MOV E,1
082   ; B4            MOV 8,2      X mod 4 = 0,1,2,3
332   ; B5            ANDI 3,2
512   ; B6            ADDI 1,2     1,2,3,4
922   ; B7            CMPI 2,2
DBA   ; B8            BRC PsHoch
F07   ; B9            RET          1, 2 stimmen schon
722   ; BA  PsHoch:   SUBI 2,2     3,4 -> 1,2 -> 4,8
422   ; BB            ADD 2,2
422   ; BC            ADD 2,2
F07   ; BD            RET
0E0   ; BE  Zugriff:  MOV E,0
380   ; BF            ANDI 8,0     gebrauchte Haelfte 0 / 8
807   ; C0            CMP 0,7
EC8   ; C1            BRZ Auf
F0D   ; C2            EXRL         Haelften tauschen, R bleibt gleich
F0E   ; C3            EXRM
F0F   ; C4            EXRA
F0D   ; C5            EXRL
F0E   ; C6            EXRM
007   ; C7            MOV 0,7      H merken
37E   ; C8  Auf:      ANDI 7,E
F0D   ; C9            EXRL         Fenster: R0-R7 = Brett
93E   ; CA            CMPI 3,E
DE1   ; CB            BRC AHoch
91E   ; CC            CMPI 1,E
DD7   ; CD            BRC A23
ED3   ; CE            BRZ L1
4F0   ; CF  L0:       ADD F,0
00F   ; D0            MOV 0,F
F0D   ; D1            EXRL         Fenster zu
F07   ; D2            RET
4F1   ; D3  L1:       ADD F,1
01F   ; D4            MOV 1,F
F0D   ; D5            EXRL         Fenster zu
F07   ; D6            RET
92E   ; D7  A23:      CMPI 2,E
EDD   ; D8            BRZ L2
4F3   ; D9  L3:       ADD F,3
03F   ; DA            MOV 3,F
F0D   ; DB            EXRL         Fenster zu
F07   ; DC            RET
4F2   ; DD  L2:       ADD F,2
02F   ; DE            MOV 2,F
F0D   ; DF            EXRL         Fenster zu
F07   ; E0            RET
95E   ; E1  AHoch:    CMPI 5,E
DEC   ; E2            BRC A67
EE8   ; E3            BRZ L5
4F4   ; E4  L4:       ADD F,4
04F   ; E5            MOV 4,F
F0D   ; E6            EXRL         Fenster zu
F07   ; E7            RET
4F5   ; E8  L5:       ADD F,5
05F   ; E9            MOV 5,F
F0D   ; EA            EXRL         Fenster zu
F07   ; EB            RET
96E   ; EC  A67:      CMPI 6,E
EF2   ; ED            BRZ L6
4F7   ; EE  L7:       ADD F,7
07F   ; EF            MOV 7,F
F0D   ; F0            EXRL         Fenster zu
F07   ; F1            RET
4F6   ; F2  L6:       ADD F,6
06F   ; F3            MOV 6,F
F0D   ; F4  Zu:       EXRL         Fenster zu
F07   ; F5            RET
