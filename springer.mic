; springer-10.mic - Springer (Knight's Tour) fuer Busch Microtronic 2090 mit 8x8-LED-Matrix (ESP2090 Studio)
; 211 Schritte (00-D2), frei: 45
; Der Springer soll jedes Feld der Matrix genau einmal betreten.  Startfeld zufaellig (RND).
; Bedienung mit den Hex-Tasten des Microtronic (KIN), kein Keypad.  Die Tasten sind wie die Spruenge auf einem
; 4x4-Feld angeordnet (0-3 untere Reihe, C-F obere Reihe):
;   D: 1 links 2 hoch    E: 1 rechts 2 hoch
;   8: 2 links 1 hoch    B: 2 rechts 1 hoch
;   4: 2 links 1 runter  7: 2 rechts 1 runter
;   1: 1 links 2 runter  2: 1 rechts 2 runter
; Farben: aktuelles Feld gelb, besuchte Felder rot (nichts blinkt).
; Jede ungueltige Taste (keine Springertaste, ueber den Rand, schon besucht) zeigt alle moeglichen Zielfelder
;   gruen; sie bleiben stehen, bis ein gueltiger Zug ausgefuehrt ist.
; Waehrend das Programm auf eine Taste wartet, zeigt das Display die besuchten Felder (dezimal).
; Nach jedem Zug prueft das Programm, ob es noch einen Zug gibt.  Wenn nicht: Spielende, die Anzeige zeigt
;   die besuchten Felder (64 = gewonnen), das Programm bleibt in einer Endlosschleife.
; Start: Matrix einschalten (Weboberflaeche: LED on, Emulator2090: m), dann RUN.  Das Programm loescht R und M selbst.
; Die Matrix bleibt dauernd wach; das Programm zeichnet nur mit Zeichenbefehlen (ACK 3, 4, 13, 14) und sendet
;   keine ganzen Bilder.  Der ESP merkt sich das Bild.  Vor jedem Befehl ist das Display aus (9,3 ms je Befehl).
; Version 10: Tasten statt Keypad, Farben statt Blinken, Hinweise (gruen) mit push/pop der Bitmatrix auf dem
;   ESP-Stapel, keine Bilder im Blockmodus mehr (die Matrix schlaeft nie), Punkte immer in der Anzeige.
; Version 09: ESP2090 Studio mit Schlafen und Wecken (Handshake mit gehaltenem F), Keypad, blinkendes Feld.
;
; Register:
;   R0 Hilfsregister (Taste, DIN, Zwischenwerte; ausserhalb der Fenster)
;   R1 P (Brettregister 0-F des zuletzt berechneten Feldes)   R2 K (Maske des Feldes)
;   R3 X, R4 Y   aktuelles Feld (X 0-7 links nach rechts, Y 0-7 unten nach oben)
;   R5 dx, R6 dy Sprung der Taste bzw. der gerade geprueften Richtung
;   R7 gefunden (Durchlauf: mindestens ein freies Zielfeld)
;   R8 X, R9 Y   Zielfeld (Pos und Matrix-Befehle arbeiten mit R8, R9)
;   RA Hinweise sichtbar (1)   RB 0 = Einzelpruefung, F-8 = Durchlauf ueber alle 8 Richtungen
;   RC Zaehler Einer, RD Zaehler Zehner (besuchte Felder dezimal; DISP 2,C zeigt RD RC)
;   RE ACK / P (Hilfsregister)   RF erstes Nibble / Summand
; Brett in M0-MF: Brettregister P = 2Y + (X >= 4), Bit K = 1 << (X mod 4) = Feld besucht.
; Es gibt nur eine Ruecksprungadresse: Unterprogramme rufen kein anderes mit CALL auf (Einspruenge enden mit GOTO).

; ---------- 1. Start: Brett leer, Matrix leer, Startfeld zufaellig ----------
F02   ; 00  START: DISOUT      Display aus: die Matrix nimmt Befehle nur bei 9,3 ms je Befehl an
F08   ; 01  CLEAR              R und M loeschen (Brett leer): R0-RF = 0 ...
F0D   ; 02  EXRL               
F0E   ; 03  EXRM               
F08   ; 04  CLEAR              ... und M0-MF = 0.  Das Brett liegt in M0-MF: Bit = Feld besucht
13E   ; 05  MOVI 3,E           ACK 3: ganze Matrix ...
13F   ; 06  MOVI 3,F           ... in Zeichenart 3 = alle Pixel aus (die Farben bleiben)
BCA   ; 07  CALL CMD           
F05   ; 08  RND                Startfeld zufaellig
0D8   ; 09  MOV D,8            X = 0-7 (Spalte, 0 = links)
378   ; 0A  ANDI 7,8           
0E9   ; 0B  MOV E,9            Y = 0-7 (Zeile, 0 = unten)
379   ; 0C  ANDI 7,9           
10D   ; 0D  MOVI 0,D           Zaehler = 1 (Startfeld), dezimal in RD RC
11C   ; 0E  MOVI 1,C           
083   ; 0F  MOV 8,3            aktuelles Feld X, Y nach R3, R4
094   ; 10  MOV 9,4            
B80   ; 11  CALL POS           P (R1 = RE) und Maske K (R2) des Feldes
02F   ; 12  MOV 2,F            F = +K: Feld besucht
B8F   ; 13  CALL ZUGR          in das Brett eintragen
13F   ; 14  MOVI 3,F           Farbe 3 = gelb: so sieht man das aktuelle Feld
BC9   ; 15  CALL COLOR         
BC2   ; 16  CALL PTON          Startfeld anzeigen (gelb)

; ---------- 2. Hauptschleife: Taste lesen, Zug oder Hinweis ----------
; Waehrend die Taste erwartet wird, zeigt das Display die besuchten Felder (dezimal).
F2C   ; 17  LOOP: DISP 2,C     Punkte anzeigen, solange auf die Taste gewartet wird
FF0   ; 18  KIN 0              Taste 0-F nach R0
F02   ; 19  DISOUT             Display aus fuer die Matrix-Befehle
; Die Tasten liegen wie auf einem 4x4-Feld: k = 4 * Reihe + Spalte (Reihe 0 = Tasten 0-3).
; Reihe und Spalte 0, 1, 2, 3 bedeuten -2, -1, +1, +2.  So entsteht der Sprung (dx, dy):
;   D: -1,+2  E: +1,+2  8: -2,+1  B: +2,+1  4: -2,-1  7: +2,-1  1: -1,-2  2: +1,-2
; Wert = Zahl + (Zahl > 1) - 2: CMPI setzt den Carry fuer Zahl > 1, ADC addiert ihn.
005   ; 1A  MOV 0,5            dx aus der Spalte k mod 4
335   ; 1B  ANDI 3,5           
915   ; 1C  CMPI 1,5           Carry = 1, wenn Spalte > 1
FB5   ; 1D  ADC 5              + Carry
725   ; 1E  SUBI 2,5           dx = Spalte - 2 + Carry
006   ; 1F  MOV 0,6            dy aus der Reihe k div 4
F96   ; 20  SHR 6              
F96   ; 21  SHR 6              
916   ; 22  CMPI 1,6           
FB6   ; 23  ADC 6              
726   ; 24  SUBI 2,6           dy = Reihe - 2 + Carry
; Gueltige Tasten: |dx| und |dy| sind 1 und 2 (oder 2 und 1).  Ecktasten (0 3 C F) haben 2 und 2,
; die mittleren Tasten (5 6 9 A) haben 1 und 1: dann ist dx + dy gerade.  Gueltig = dx + dy ungerade.
050   ; 25  MOV 5,0            
460   ; 26  ADD 6,0            R0 = dx + dy
310   ; 27  ANDI 1,0           Bit 1 = ungerade
E53   ; 28  BRZ INVAL          gerade: keine Springertaste -> Hinweise
10B   ; 29  MOVI 0,B           B = 0: Einzelpruefung dieses Zuges (kein Durchlauf aller Richtungen)

; ---------- 3. PROBE: ist das Zielfeld (X+dx, Y+dy) frei? ----------
; Wird auch vom Durchlauf aller 8 Richtungen benutzt (B = F ... 8).  Das Zielfeld liegt in R8, R9.
038   ; 2A  PROBE: MOV 3,8     Ziel = aktuelles Feld + (dx, dy)
049   ; 2B  MOV 4,9            
458   ; 2C  ADD 5,8            
469   ; 2D  ADD 6,9            
978   ; 2E  CMPI 7,8           ausserhalb des Bretts? (negativ erscheint als 8-F)
D37   ; 2F  BRC BAD            
979   ; 30  CMPI 7,9           
D37   ; 31  BRC BAD            
B80   ; 32  CALL POS           P und Maske K des Zielfeldes
10F   ; 33  MOVI 0,F           nur lesen
B8F   ; 34  CALL ZUGR          F = Brettregister des Feldes
22F   ; 35  AND 2,F            Feld schon besucht?
E3A   ; 36  BRZ FREE           nein -> frei
90B   ; 37  BAD: CMPI 0,B      B > 0: Durchlauf, weiter mit der naechsten Richtung
D40   ; 38  BRC NEXT           
C53   ; 39  GOTO INVAL         Einzelpruefung: Zug nicht moeglich -> Hinweise
90B   ; 3A  FREE: CMPI 0,B     
E60   ; 3B  BRZ MOVE           Einzelpruefung: Zug ausfuehren
117   ; 3C  MOVI 1,7           Durchlauf: es gibt mindestens einen Zug
90A   ; 3D  CMPI 0,A           Hinweise zeigen?
E40   ; 3E  BRZ NEXT           nein (nur zaehlen)
BC2   ; 3F  CALL PTON          ja: Zielfeld in der aktiven Farbe (gruen) anschalten

; ---------- 4. Naechste Richtung ----------
; 8 Richtungen aus (dx, dy) = (1, 2): dreimal um 90 Grad drehen (dx, dy) -> (-dy, dx),
; dann dx und dy tauschen und nochmal dreimal drehen.  B zaehlt F ... 8, bei 7 ist alles probiert.
71B   ; 40  NEXT: SUBI 1,B     
97B   ; 41  CMPI 7,B           
E4E   ; 42  BRZ PEND           alle 8 Richtungen probiert
9BB   ; 43  CMPI B,B           
E4A   ; 44  BRZ SWAP           nach 4 Richtungen: dx und dy tauschen
060   ; 45  MOV 6,0            drehen: (dx, dy) -> (-dy, dx)
056   ; 46  MOV 5,6            
105   ; 47  MOVI 0,5           
605   ; 48  SUB 0,5            
C2A   ; 49  GOTO PROBE         
050   ; 4A  SWAP: MOV 5,0      dx und dy tauschen
065   ; 4B  MOV 6,5            
006   ; 4C  MOV 0,6            
C2A   ; 4D  GOTO PROBE         
90A   ; 4E  PEND: CMPI 0,A     Durchlauf fertig. Hinweise gezeigt?
D17   ; 4F  BRC LOOP           ja: auf die naechste Taste warten
907   ; 50  CMPI 0,7           nur gezaehlt: gab es einen Zug?
E7E   ; 51  BRZ END            nein: Spielende
C17   ; 52  GOTO LOOP          

; ---------- 5. Hinweise: keine Springertaste oder Zug nicht moeglich ----------
; Bleiben stehen, bis ein gueltiger Zug ausgefuehrt wird.  Vor den gruenen Punkten wird die Bitmatrix auf
; den Stapel des ESP gelegt (push, ACK 13); beim Zug holt pop sie zurueck: ein Befehl loescht alle Hinweise.
90A   ; 53  INVAL: CMPI 0,A    Hinweise schon sichtbar?
D17   ; 54  BRC LOOP           ja: nichts tun
11A   ; 55  MOVI 1,A           A = 1: Hinweise sichtbar
12F   ; 56  MOVI 2,F           ACK 13, 2 = push der Bitmatrix
1DE   ; 57  MOVI D,E           
BCA   ; 58  CALL CMD           
14F   ; 59  MOVI 4,F           Farbe 4 = gruen
BC9   ; 5A  CALL COLOR         
115   ; 5B  PINIT: MOVI 1,5    Durchlauf ueber alle 8 Richtungen: erste Richtung (1, 2)
126   ; 5C  MOVI 2,6           
1FB   ; 5D  MOVI F,B           B = F
107   ; 5E  MOVI 0,7           R7 = 0: noch kein Zug gefunden
C2A   ; 5F  GOTO PROBE         

; ---------- 6. Zug ausfuehren ----------
; Das Zielfeld steht in R8, R9; P (R1) und Maske K (R2) sind noch von PROBE.
90A   ; 60  MOVE: CMPI 0,A     Hinweise sichtbar?
E66   ; 61  BRZ MV1            
10A   ; 62  MOVI 0,A           A = 0
16F   ; 63  MOVI 6,F           ACK 13, 6 = pop der Bitmatrix: Hinweise weg
1DE   ; 64  MOVI D,E           
BCA   ; 65  CALL CMD           
01E   ; 66  MV1: MOV 1,E       neues Feld besucht
02F   ; 67  MOV 2,F            
B8F   ; 68  CALL ZUGR          
085   ; 69  MOV 8,5            Ziel in R5, R6 merken
096   ; 6A  MOV 9,6            
038   ; 6B  MOV 3,8            altes Feld ...
049   ; 6C  MOV 4,9            
11F   ; 6D  MOVI 1,F           Farbe 1 = rot: besuchtes Feld
BC9   ; 6E  CALL COLOR         
BC6   ; 6F  CALL PTCOL         ... nur umfaerben (Zeichenart 0: das Pixel bleibt an)
058   ; 70  MOV 5,8            Ziel wird das aktuelle Feld
069   ; 71  MOV 6,9            
083   ; 72  MOV 8,3            
094   ; 73  MOV 9,4            
13F   ; 74  MOVI 3,F           Farbe 3 = gelb
BC9   ; 75  CALL COLOR         
BC2   ; 76  CALL PTON          neues Feld gelb anschalten
51C   ; 77  ADDI 1,C           Zaehler + 1 (dezimal)
99C   ; 78  CMPI 9,C           
D7B   ; 79  BRC ZEHN           
C5B   ; 7A  GOTO PINIT         gibt es noch einen Zug?
10C   ; 7B  ZEHN: MOVI 0,C     
51D   ; 7C  ADDI 1,D           
C5B   ; 7D  GOTO PINIT         

; ---------- 7. Spielende: kein Zug mehr, Punkte stehen in der Anzeige (64 = gewonnen) ----------
F2C   ; 7E  END: DISP 2,C      
C7F   ; 7F  HALT: GOTO HALT    

; ---------- 8. POS: Zielfeld (R8, R9) -> P und Maske K ----------
; P = 2Y + (X >= 4) = Nummer des Brettregisters 0-F (R1 und RE), K = 1 << (X mod 4) (R2).
09E   ; 80  POS: MOV 9,E       
4EE   ; 81  ADD E,E            2Y
938   ; 82  CMPI 3,8           Carry = 1, wenn X >= 4
FBE   ; 83  ADC E              P = 2Y + (X >= 4)
0E1   ; 84  MOV E,1            
082   ; 85  MOV 8,2            X mod 4 = 0, 1, 2, 3
332   ; 86  ANDI 3,2           
512   ; 87  ADDI 1,2           1, 2, 3, 4
922   ; 88  CMPI 2,2           
D8B   ; 89  BRC PSH            
F07   ; 8A  RET                1, 2 stimmen schon
722   ; 8B  PSH: SUBI 2,2      3, 4 -> 1, 2 -> 4, 8
422   ; 8C  ADD 2,2            
422   ; 8D  ADD 2,2            
F07   ; 8E  RET                

; ---------- 9. ZUGR: Brettregister M[P] = M[P] + F, danach F = neuer Wert ----------
; Eingabe: E = P, F = Summand (+K setzen, 0 nur lesen), R9 = Y des Feldes.  Y >= 4: obere Haelfte (P >= 8).
; Die Haelfte wird in R0-R7 eingeblendet (EXRL bzw. EXRA, EXRM, EXRA); R8-RF bleiben unveraendert.
939   ; 8F  ZUGR: CMPI 3,9     Y >= 4?
D93   ; 90  BRC ZUP            
F0D   ; 91  EXRL               untere Haelfte M0-M7 in R0-R7
C96   ; 92  GOTO ZSEL          
F0F   ; 93  ZUP: EXRA          obere Haelfte M8-MF in R0-R7
F0E   ; 94  EXRM               
F0F   ; 95  EXRA               
37E   ; 96  ZSEL: ANDI 7,E     Register 0-7 im Fenster
93E   ; 97  CMPI 3,E           
DAA   ; 98  BRC Z47            
91E   ; 99  CMPI 1,E           
DA2   ; 9A  BRC Z23            
E9F   ; 9B  BRZ Z1             
4F0   ; 9C  Z0: ADD F,0        
00F   ; 9D  MOV 0,F            
CBA   ; 9E  GOTO ZT            
4F1   ; 9F  Z1: ADD F,1        
01F   ; A0  MOV 1,F            
CBA   ; A1  GOTO ZT            
92E   ; A2  Z23: CMPI 2,E      
EA7   ; A3  BRZ Z2             
4F3   ; A4  Z3: ADD F,3        
03F   ; A5  MOV 3,F            
CBA   ; A6  GOTO ZT            
4F2   ; A7  Z2: ADD F,2        
02F   ; A8  MOV 2,F            
CBA   ; A9  GOTO ZT            
95E   ; AA  Z47: CMPI 5,E      
DB3   ; AB  BRC Z67            
EB0   ; AC  BRZ Z5             
4F4   ; AD  Z4: ADD F,4        
04F   ; AE  MOV 4,F            
CBA   ; AF  GOTO ZT            
4F5   ; B0  Z5: ADD F,5        
05F   ; B1  MOV 5,F            
CBA   ; B2  GOTO ZT            
96E   ; B3  Z67: CMPI 6,E      
EB8   ; B4  BRZ Z6             
4F7   ; B5  Z7: ADD F,7        
07F   ; B6  MOV 7,F            
CBA   ; B7  GOTO ZT            
4F6   ; B8  Z6: ADD F,6        
06F   ; B9  MOV 6,F            
939   ; BA  ZT: CMPI 3,9       Fenster wieder schliessen (selbe Folge)
DBE   ; BB  BRC ZTU            
F0D   ; BC  EXRL               
F07   ; BD  RET                
F0F   ; BE  ZTU: EXRA          
F0E   ; BF  EXRM               
F0F   ; C0  EXRA               
F07   ; C1  RET                

; ---------- 10. Matrix-Befehle (Zeichenmodus des ESP2090, die Matrix bleibt dauernd wach) ----------
; CMD: E = ACK, F = erstes Nibble, R9 = zweites Nibble (Y des Zielfeldes; bei Befehlen mit einem Nibble ohne Bedeutung).
; Zeichenart steckt in X (+8 = Pixel und Farbe) und Y (+8 = Ausschnitt): hier nur ohne +8 und mit X + 8.
; Die Einspruenge enden mit GOTO CMD statt CALL: es gibt nur eine Ruecksprungadresse.
08F   ; C2  PTON: MOV 8,F      Punkt (ACK 4): Pixel an, in der aktiven Farbe: X + 8
58F   ; C3  ADDI 8,F           
14E   ; C4  MOVI 4,E           
CCA   ; C5  GOTO CMD           
08F   ; C6  PTCOL: MOV 8,F     Punkt (ACK 4) ohne +8: nur die Farbe, das Pixel bleibt, wie es ist
14E   ; C7  MOVI 4,E           
CCA   ; C8  GOTO CMD           
1EE   ; C9  COLOR: MOVI E,E    ACK 14: aktive Farbe F (1 rot, 3 gelb, 4 gruen); weiter in CMD
FD0   ; CA  CMD: DIN 0         auf REQ warten
310   ; CB  ANDI 1,0           
ECA   ; CC  BRZ CMD            
FEE   ; CD  DOT E              ACK
FEF   ; CE  DOT F              Nibble 1
FE9   ; CF  DOT 9              Nibble 2
100   ; D0  MOVI 0,0           
FE0   ; D1  DOT 0              Ausgaenge auf 0
F07   ; D2  RET                
